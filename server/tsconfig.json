{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "sourceMap": false,
    "target": "ES2020",
    "noEmit": false,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*", "src/types/express/index.d.ts"],
  "exclude": ["node_modules"]
}

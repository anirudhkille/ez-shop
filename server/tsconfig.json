{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "outDir": "dist",
    "rootDir": "src",

    "target": "ES2020",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "sourceMap": false,
    "noEmit": false,

    "skipLibCheck": true,

    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*", "src/types/express/index.d.ts"],
  "exclude": ["node_modules"]
}

NODE_ENV=development
PORT=7777

MONGO_URI=mongodb://localhost:27017/test

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Google OAuth (web). GOOGLE_CLIENT_ID is the web client and an accepted
# audience for the ID token the mobile app sends to /api/user/google/mobile.
# GOOGLE_ANDROID_CLIENT_ID is optional and adds the Android client as a second
# accepted audience.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:7777/api/user/google/callback

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ez-shop
R2_PUBLIC_URL=https://ezshop-cdn.anirudhkille.com

# Server-side Mapbox token for address search. Keep it out of the client bundle.
MAPBOX_TOKEN=

RESEND_API_KEY=
EMAIL_FROM=EZ Shop <no-reply@example.com>

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Sentry initializes only when NODE_ENV=production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

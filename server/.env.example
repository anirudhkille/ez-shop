NODE_ENV=development
PORT=7777

MONGO_URI=mongodb://localhost:27017/test

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Google OAuth (web). GOOGLE_CLIENT_ID is also the audience of the ID token
# the mobile app sends to POST /api/user/google/mobile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:7777/api/user/google/callback

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Server-side Mapbox token for address search. Keep it out of the client bundle.
MAPBOX_TOKEN=

RESEND_API_KEY=
EMAIL_FROM=EZ Shop <no-reply@example.com>

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
